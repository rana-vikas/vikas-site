DATABASE_URL=postgresql://vikas:changeme@db:5432/vikas_site
AUTH_SECRET=
AUTH_URL=http://<server-lan-ip>:3000
# next-auth v4 (Phase 8) reads NEXTAUTH_URL, not AUTH_URL — kept in sync manually
NEXTAUTH_URL=http://<server-lan-ip>:3000
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://<server-lan-ip>:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=vikas-media
NEXT_PUBLIC_SITE_URL=http://<server-lan-ip>:3000
ADMIN_EMAIL=
# Only read once by prisma/seed.ts to bootstrap the admin User row (hashed,
# never stored in plaintext) — not needed after the first seed run.
ADMIN_PASSWORD=
# Phase 12 (production only) — leave unset until you have a real domain and
# are ready to go live. See README's "Going to production" section: once
# set, AUTH_URL/NEXTAUTH_URL/NEXT_PUBLIC_SITE_URL/STORAGE_PUBLIC_URL all
# swap from the LAN IP to https://{DOMAIN} — same mechanism, no code changes.
DOMAIN=
