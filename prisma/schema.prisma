generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js (NextAuth) core tables — https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Site content

model Profile {
  id            String   @id @default(cuid())
  name          String
  headline      String
  tagline       String
  summary       String?  @db.Text
  resumeMediaId String?
  resumeMedia   Media?   @relation(fields: [resumeMediaId], references: [id])
  updatedAt     DateTime @updatedAt
}

// Central file registry — every stored file (photo, video, resume) is a Media
// row referencing an object key in the S3-compatible bucket (MinIO now, R2/S3
// later). Content models reference Media instead of storing raw URLs.
model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())

  travelCovers        TravelTrip[]
  photos              Photo[]
  profiles            Profile[]
  projectCovers       Project[]
  fitnessEntries      FitnessEntry[]
  cricketPlayerPhotos CricketPlayer[]
  cricketMemories     CricketMemory[]
  travelMemories      TravelMemory[]
}

model TravelTrip {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  location     String
  summary      String?          @db.Text
  startDate    DateTime
  endDate      DateTime?
  coverMediaId String?
  coverMedia   Media?           @relation(fields: [coverMediaId], references: [id])
  published    Boolean          @default(false)
  // Only one trip should be latest = true at a time — enforced by
  // lib/travel/setLatestTrip.ts, which Phase 8's admin publish flow calls.
  latest       Boolean          @default(false)
  locations    TravelLocation[]
  memories     TravelMemory[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model TravelLocation {
  id          String     @id @default(cuid())
  tripId      String
  trip        TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  description String?    @db.Text
  latitude    Float?
  longitude   Float?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
}

model TravelMemory {
  id        String     @id @default(cuid())
  tripId    String
  trip      TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title     String
  caption   String?    @db.Text
  mediaId   String?
  media     Media?     @relation(fields: [mediaId], references: [id])
  order     Int        @default(0)
  published Boolean    @default(true)
  createdAt DateTime   @default(now())
}

model PhotoAlbum {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  published Boolean  @default(false)
  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String     @id @default(cuid())
  albumId   String
  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media      @relation(fields: [mediaId], references: [id])
  caption   String?
  featured  Boolean    @default(false)
  order     Int        @default(0)
  published Boolean    @default(true)
  createdAt DateTime   @default(now())

  // EXIF, shown in the lightbox metadata panel
  camera       String?
  lens         String?
  aperture     String?
  shutterSpeed String?
  iso          Int?
  focalLength  String?
  takenAt      DateTime?
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?  @db.Text
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Career

model Experience {
  id          String    @id @default(cuid())
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?   @db.Text
  order       Int       @default(0)
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String
  description  String?  @db.Text
  url          String?
  repoUrl      String?
  coverMediaId String?
  coverMedia   Media?   @relation(fields: [coverMediaId], references: [id])
  featured     Boolean  @default(false)
  published    Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Achievement {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  date        DateTime?
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Certification {
  id        String    @id @default(cuid())
  title     String
  issuer    String
  date      DateTime?
  url       String?
  order     Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// Fitness

model FitnessJourney {
  id        String   @id @default(cuid())
  startYear Int
  story     String?  @db.Text
  updatedAt DateTime @updatedAt
}

model FitnessChallenge {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  lengthDays Int
  summary    String?        @db.Text
  startDate  DateTime?
  endDate    DateTime?
  published  Boolean        @default(false)
  entries    FitnessEntry[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model FitnessEntry {
  id          String           @id @default(cuid())
  challengeId String
  challenge   FitnessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dayNumber   Int
  date        DateTime?
  title       String?
  notes       String?          @db.Text
  mediaId     String?
  media       Media?           @relation(fields: [mediaId], references: [id])
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@unique([challengeId, dayNumber])
}

model Competition {
  id        String    @id @default(cuid())
  name      String
  result    String?
  location  String?
  date      DateTime?
  order     Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// Cricket

model CricketTeam {
  id          String   @id @default(cuid())
  name        String
  foundedYear Int
  tagline     String?
  story       String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model CricketPlayer {
  id           String   @id @default(cuid())
  name         String
  role         String?
  bio          String?  @db.Text
  photoMediaId String?
  photoMedia   Media?   @relation(fields: [photoMediaId], references: [id])
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Tournament {
  id        String         @id @default(cuid())
  name      String
  location  String?
  startDate DateTime?
  endDate   DateTime?
  result    String?
  order     Int            @default(0)
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  matches   CricketMatch[]
}

model CricketMatch {
  id           String      @id @default(cuid())
  opponent     String
  matchDate    DateTime
  result       String?
  summary      String?     @db.Text
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
}

model CricketMemory {
  id        String    @id @default(cuid())
  title     String
  caption   String?   @db.Text
  mediaId   String?
  media     Media?    @relation(fields: [mediaId], references: [id])
  date      DateTime?
  order     Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
}
